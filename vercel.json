{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://ustaz.runasp.net/api/:path*" },
    { "source": "/uploads/:path*", "destination": "https://ustaz.runasp.net/uploads/:path*" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ]
}
